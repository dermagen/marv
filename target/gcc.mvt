;; =============================================================================
;; gcc.mvt -- MARV Target Description for Restricted C99 (GCC)
;; Assumes `gcc` is installed and in PATH.
;; =============================================================================

(marv-target
  (name     "gcc")
  (type     cc)
  (obj-ext  ".c")
  (cc       "gcc")
  (cflags   ("-std=c99" "-O2" "-D_DEFAULT_SOURCE" "-D_XOPEN_SOURCE=700"
             "-Wno-unused-variable" "-Wno-unused-function" "-Wno-unused-label" "-Wno-main"))
  (ldflags  ())
  (ldlibs   ("-lm"))
  (link-cmd "gcc -std=c99 -O2 -D_DEFAULT_SOURCE -D_XOPEN_SOURCE=700 -Wno-unused-variable -Wno-unused-function -Wno-unused-label -Wno-main ~src -o ~exe -lm"))
