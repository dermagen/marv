;;; errno.mvh — MARV error numbers and mutable $errno global
;;; Constants taken directly from WCPL/WASI `errno.h` (zero remapping on .wo).
;;; Native `lib/errno.c` exports `errno_errno` and translates host OS errno values.

(interface $errno
  (const $ESUCCESS        i32 0)
  (const $E2BIG           i32 1)
  (const $EACCES          i32 2)
  (const $EADDRINUSE      i32 3)
  (const $EADDRNOTAVAIL   i32 4)
  (const $EAFNOSUPPORT    i32 5)
  (const $EAGAIN          i32 6)
  (const $EALREADY        i32 7)
  (const $EBADF           i32 8)
  (const $EBADMSG         i32 9)
  (const $EBUSY           i32 10)
  (const $ECANCELED       i32 11)
  (const $ECHILD          i32 12)
  (const $ECONNABORTED    i32 13)
  (const $ECONNREFUSED    i32 14)
  (const $ECONNRESET      i32 15)
  (const $EDEADLK         i32 16)
  (const $EDESTADDRREQ    i32 17)
  (const $EDOM            i32 18)
  (const $EDQUOT          i32 19)
  (const $EEXIST          i32 20)
  (const $EFAULT          i32 21)
  (const $EFBIG           i32 22)
  (const $EHOSTUNREACH    i32 23)
  (const $EIDRM           i32 24)
  (const $EILSEQ          i32 25)
  (const $EINPROGRESS     i32 26)
  (const $EINTR           i32 27)
  (const $EINVAL          i32 28)
  (const $EIO             i32 29)
  (const $EISCONN         i32 30)
  (const $EISDIR          i32 31)
  (const $ELOOP           i32 32)
  (const $EMFILE          i32 33)
  (const $EMLINK          i32 34)
  (const $EMSGSIZE        i32 35)
  (const $EMULTIHOP       i32 36)
  (const $ENAMETOOLONG    i32 37)
  (const $ENETDOWN        i32 38)
  (const $ENETRESET       i32 39)
  (const $ENETUNREACH     i32 40)
  (const $ENFILE          i32 41)
  (const $ENOBUFS         i32 42)
  (const $ENODEV          i32 43)
  (const $ENOENT          i32 44)
  (const $ENOEXEC         i32 45)
  (const $ENOLCK          i32 46)
  (const $ENOLINK         i32 47)
  (const $ENOMEM          i32 48)
  (const $ENOMSG          i32 49)
  (const $ENOPROTOOPT     i32 50)
  (const $ENOSPC          i32 51)
  (const $ENOSYS          i32 52)
  (const $ENOTCONN        i32 53)
  (const $ENOTDIR         i32 54)
  (const $ENOTEMPTY       i32 55)
  (const $ENOTRECOVERABLE i32 56)
  (const $ENOTSOCK        i32 57)
  (const $ENOTSUP         i32 58)
  (const $ENOTTY          i32 59)
  (const $ENXIO           i32 60)
  (const $EOVERFLOW       i32 61)
  (const $EOWNERDEAD      i32 62)
  (const $EPERM           i32 63)
  (const $EPIPE           i32 64)
  (const $EPROTO          i32 65)
  (const $EPROTONOSUPPORT i32 66)
  (const $EPROTOTYPE      i32 67)
  (const $ERANGE          i32 68)
  (const $EROFS           i32 69)
  (const $ESPIPE          i32 70)
  (const $ESRCH           i32 71)
  (const $ESTALE          i32 72)
  (const $ETIMEDOUT       i32 73)
  (const $ETXTBSY         i32 74)
  (const $EXDEV           i32 75)
  (const $ENOTCAPABLE     i32 76)
  (const $ERRNO_MAXERR    i32 76)

  (global $errno (mut i32))
)
