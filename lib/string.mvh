;;; string.mvh — MARV string and memory operations interface
;;; Matches WCPL `string.wo` and native `lib/string.c` (MARV internal ABI).

(include system $ctype)
(include system $errno)

(interface $string
  (func $memcpy      (param $dst ptr) (param $src ptr) (param $n i32) (result ptr))
  (func $memmove     (param $dst ptr) (param $src ptr) (param $n i32) (result ptr))
  (func $strcpy      (param $dst ptr) (param $src ptr) (result ptr))
  (func $strncpy     (param $dst ptr) (param $src ptr) (param $n i32) (result ptr))
  (func $strcat      (param $dst ptr) (param $src ptr) (result ptr))
  (func $strncat     (param $dst ptr) (param $src ptr) (param $n i32) (result ptr))
  (func $memcmp      (param $s1 ptr) (param $s2 ptr) (param $n i32) (result i32))
  (func $strcmp      (param $s1 ptr) (param $s2 ptr) (result i32))
  (func $strcoll     (param $s1 ptr) (param $s2 ptr) (result i32))
  (func $strncmp     (param $s1 ptr) (param $s2 ptr) (param $n i32) (result i32))
  (func $strxfrm     (param $dst ptr) (param $src ptr) (param $n i32) (result i32))
  (func $memchr      (param $s ptr) (param $c i32) (param $n i32) (result ptr))
  (func $strchr      (param $s ptr) (param $c i32) (result ptr))
  (func $strcspn     (param $s ptr) (param $cs ptr) (result i32))
  (func $strpbrk     (param $s ptr) (param $cs ptr) (result ptr))
  (func $strrchr     (param $s ptr) (param $c i32) (result ptr))
  (func $strspn      (param $s ptr) (param $cs ptr) (result i32))
  (func $strstr      (param $s ptr) (param $ss ptr) (result ptr))
  (func $strtok      (param $s ptr) (param $sep ptr) (result ptr))
  (func $strtok_r    (param $s ptr) (param $sep ptr) (param $lastp ptr) (result ptr))
  (func $memset      (param $dst ptr) (param $c i32) (param $n i32) (result ptr))
  (func $strlen      (param $s ptr) (result i32))
  (func $strerror    (param $errnum i32) (result ptr))
  (func $strdup      (param $s ptr) (result ptr))
  (func $strndup     (param $s ptr) (param $n i32) (result ptr))
  (func $memccpy     (param $d ptr) (param $s ptr) (param $c i32) (param $n i32) (result ptr))
  (func $memmem      (param $haystack ptr) (param $n i32) (param $needle ptr) (param $m i32) (result ptr))
  (func $strnlen     (param $s ptr) (param $maxlen i32) (result i32))
  (func $memswap     (param $s1 ptr) (param $s2 ptr) (param $n i32))
  (func $bzero       (param $s ptr) (param $n i32))
  (func $strcasecmp  (param $s1 ptr) (param $s2 ptr) (result i32))
  (func $strncasecmp (param $s1 ptr) (param $s2 ptr) (param $n i32) (result i32))
)
