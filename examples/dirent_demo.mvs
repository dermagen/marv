;; =============================================================================
;; examples/dirent_demo.mvs -- MARV-ABI `dirent` Demonstration
;;
;; Demonstrates calling `lib/dirent.c` (and WCPL's `dirent` + `stdio` +
;; `string` modules) directly from MARV using ONLY MARV-ABI interfaces,
;; `(record $dirent ...)` field access (`field.get`, `field.addr`), normal MARV
;; function pointers (`ref.func`), and zero `c-` prefixes or FFI shims.
;; =============================================================================

(include system $dirent)
(include system $stdio)
(include system $string)

(module $dirent_demo
  (data $ex_dir     const align 1 "examples\x00;")
  (data $dot_dir    const align 1 ".\x00;")
  (data $hdr_banner const align 1 "=== MARV-Lowered dirent Library Demo ===\x00;")
  (data $hdr_scan1  const align 1 "1. scandir('examples', filter_mvs_or_dir, alphasort):\x00;")
  (data $hdr_scan2  const align 1 "2. scandir('examples', filter_mvs_or_dir, cmp_by_len_asc):\x00;")
  (data $ftr_pass   const align 1 "=== ALL LOWERED DIRENT CHECKS PASSED ===\x00;")
  (data $exp_dir    const align 1 "multimod\x00;")
  (data $exp_q      const align 1 "queens.mvs\x00;")
  (data $exp_l      const align 1 "libc_demo.mvs\x00;")
  (data $exp_d      const align 1 "dirent_demo.mvs\x00;")

  ;; Return "examples" when running from the repository root, or "." if already inside `examples/`
  (func $target_dir
    (result ptr)
    (local $d ptr)
    (local.set $d (call $opendir (ref.data $ex_dir)))
    (if (ptr.eqz $d)
      (then (return (ref.data $dot_dir)))
      (else
        (drop (call $closedir $d))
        (return (ref.data $ex_dir)))))

  ;; Format a single directory entry line into `buf`:
  ;;   "  [#0] DIR (len=08) multimod" or "  [#1] REG (len=10) queens.mvs"
  (func $print_entry_line
    (param $idx i32) (param $ent ptr)
    (frame 128)
    (local $buf ptr)
    (local $dtype i32)
    (local $namlen i32)
    (local $name ptr)
    (local $pos i32)
    (local $i i32)
    (local $ch i32)

    (local.set $buf (frame.addr 0))
    ;; Load canonical fields directly from `(record $dirent ...)`!
    (local.set $dtype  (field.get  $dirent $d_type $ent))
    (local.set $name   (field.addr $dirent $d_name $ent))
    (local.set $namlen (call $strlen $name))

    ;; "  [#"
    (i32.store8 offset 0 $buf (i32.const 32))
    (i32.store8 offset 1 $buf (i32.const 32))
    (i32.store8 offset 2 $buf (i32.const 91))
    (i32.store8 offset 3 $buf (i32.const 35))
    (i32.store8 offset 4 $buf (i32.add (i32.const 48) $idx))
    (i32.store8 offset 5 $buf (i32.const 93))
    (i32.store8 offset 6 $buf (i32.const 32))

    ;; "DIR" or "REG"
    (if (i32.eq $dtype (const $DT_DIR))
      (then
        (i32.store8 offset 7 $buf (i32.const 68))  ;; 'D'
        (i32.store8 offset 8 $buf (i32.const 73))  ;; 'I'
        (i32.store8 offset 9 $buf (i32.const 82))) ;; 'R'
      (else
        (i32.store8 offset 7 $buf (i32.const 82))  ;; 'R'
        (i32.store8 offset 8 $buf (i32.const 69))  ;; 'E'
        (i32.store8 offset 9 $buf (i32.const 71)))) ;; 'G'

    ;; " (len="
    (i32.store8 offset 10 $buf (i32.const 32))
    (i32.store8 offset 11 $buf (i32.const 40))
    (i32.store8 offset 12 $buf (i32.const 108))
    (i32.store8 offset 13 $buf (i32.const 101))
    (i32.store8 offset 14 $buf (i32.const 110))
    (i32.store8 offset 15 $buf (i32.const 61))
    (i32.store8 offset 16 $buf (i32.add (i32.const 48) (i32.div_s $namlen (i32.const 10))))
    (i32.store8 offset 17 $buf (i32.add (i32.const 48) (i32.rem_s $namlen (i32.const 10))))
    (i32.store8 offset 18 $buf (i32.const 41))
    (i32.store8 offset 19 $buf (i32.const 32))

    ;; Copy `d_name` bytes
    (local.set $pos (i32.const 20))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy_lp
        (br_if $copy_done (i32.ge_s $i $namlen))
        (local.set $ch (i32.load8_u (ptr.add $name $i)))
        (i32.store8 (ptr.add $buf $pos) $ch)
        (local.set $pos (i32.add $pos (i32.const 1)))
        (local.set $i   (i32.add $i   (i32.const 1)))
        (br $copy_lp)))
    (i32.store8 (ptr.add $buf $pos) (i32.const 0))
    (drop (call $puts $buf)))

  ;; ---------------------------------------------------------------------------
  ;; Normal MARV Callback 1: Filter for directories OR `*.mvs` files
  ;; Signature: `(param $ent ptr) (result i32)` -- NO `c.callback` needed!
  ;; ---------------------------------------------------------------------------
  (func $filter_mvs_or_dir
    (param $ent ptr) (result i32)
    (local $dtype i32)
    (local $len i32)
    (local $name ptr)

    (local.set $dtype (field.get $dirent $d_type $ent))
    (if (i32.eq $dtype (const $DT_DIR))
      (then (return (i32.const 1)))
      (else))

    (local.set $name (field.addr $dirent $d_name $ent))
    (local.set $len  (call $strlen $name))
    (if (i32.lt_s $len (i32.const 4))
      (then (return (i32.const 0)))
      (else))

    ;; Check if last 4 characters are ".mvs" (46, 109, 118, 115)
    (local.set $name (ptr.add $name (i32.sub $len (i32.const 4))))
    (if (i32.and
          (i32.and (i32.eq (i32.load8_u offset 0 $name) (i32.const 46))
                   (i32.eq (i32.load8_u offset 1 $name) (i32.const 109)))
          (i32.and (i32.eq (i32.load8_u offset 2 $name) (i32.const 118))
                   (i32.eq (i32.load8_u offset 3 $name) (i32.const 115))))
      (then (return (i32.const 1)))
      (else (return (i32.const 0)))))

  ;; ---------------------------------------------------------------------------
  ;; Normal MARV Callback 2: Sort by ascending `d_name` length, then alphabetically
  ;; Signature: `(param $da ptr) (param $db ptr) (result i32)`
  ;; (`$da` and `$db` are `const struct dirent **` -- 8-byte pointer slots)
  ;; ---------------------------------------------------------------------------
  (func $cmp_by_len_asc
    (param $da ptr) (param $db ptr) (result i32)
    (local $ea ptr)
    (local $eb ptr)
    (local $la i32)
    (local $lb i32)
    (local.set $ea (ptr.load $da))
    (local.set $eb (ptr.load $db))
    (local.set $la (call $strlen (field.addr $dirent $d_name $ea)))
    (local.set $lb (call $strlen (field.addr $dirent $d_name $eb)))
    (if (i32.ne $la $lb)
      (then (return (i32.sub $la $lb)))
      (else (return (call $alphasort $da $db)))))

  ;; ---------------------------------------------------------------------------
  ;; Part 1: Test `opendir`, `readdir`, `telldir`, `seekdir`, `rewinddir`, `closedir`
  ;; Returns 100 on success, negative on failure.
  ;; ---------------------------------------------------------------------------
  (func $test_stream_ops (export "test_stream_ops")
    (result i32)
    (local $dir ptr)
    (local $ent ptr)
    (local $reg_count i32)
    (local $dir_count i32)
    (local $total i32)
    (local $dtype i32)
    (local $ino i64)
    (local $pos i64)
    (local $after_seek i32)

    (local.set $dir (call $opendir (call $target_dir)))
    (if (ptr.eqz $dir)
      (then (return (i32.const -1)))
      (else))

    (local.set $reg_count (i32.const 0))
    (local.set $dir_count (i32.const 0))
    (local.set $total     (i32.const 0))

    (block $eof
      (loop $rd_lp
        (local.set $ent (call $readdir $dir))
        (br_if $eof (ptr.eqz $ent))

        ;; Verify `d_ino > 0` and `(field.addr $dirent $d_name $ent) == (ptr.add $ent 9)`
        (local.set $ino (field.get $dirent $d_ino $ent))
        (if (i64.le_s $ino (i64.const 0))
          (then (return (i32.const -2)))
          (else))
        (if (ptr.ne (field.addr $dirent $d_name $ent)
                    (ptr.add $ent (offsetof $dirent $d_name)))
          (then (return (i32.const -3)))
          (else))

        (local.set $dtype (field.get $dirent $d_type $ent))
        (if (i32.eq $dtype (const $DT_REG))
          (then (local.set $reg_count (i32.add $reg_count (i32.const 1))))
          (else
            (if (i32.eq $dtype (const $DT_DIR))
              (then (local.set $dir_count (i32.add $dir_count (i32.const 1))))
              (else))))
        (local.set $total (i32.add $total (i32.const 1)))
        (br $rd_lp)))

    ;; Expect at least 4 regular files (`README.md` + 3 `.mvs` files) and 1 directory (`multimod`)
    (if (i32.or (i32.lt_s $reg_count (i32.const 4))
                (i32.ne   $dir_count (i32.const 1)))
      (then (return (i32.const -4)))
      (else))

    ;; Verify `telldir` (i64) matches `$total`
    (local.set $pos (call $telldir $dir))
    (if (i64.ne $pos (i64.extend_i32_s $total))
      (then (return (i32.const -5)))
      (else))

    ;; Test `seekdir` back to entry #2 (i64) and read remaining `total - 2` entries
    (call $seekdir $dir (i64.const 2))
    (if (i64.ne (call $telldir $dir) (i64.const 2))
      (then (return (i32.const -6)))
      (else))

    (local.set $after_seek (i32.const 0))
    (block $eof2
      (loop $rd2
        (local.set $ent (call $readdir $dir))
        (br_if $eof2 (ptr.eqz $ent))
        (local.set $after_seek (i32.add $after_seek (i32.const 1)))
        (br $rd2)))
    (if (i32.ne $after_seek (i32.sub $total (i32.const 2)))
      (then (return (i32.const -7)))
      (else))

    ;; Test `rewinddir` -> resets `telldir` to 0
    (call $rewinddir $dir)
    (if (i64.ne (call $telldir $dir) (i64.const 0))
      (then (return (i32.const -8)))
      (else))
    (if (ptr.eqz (call $readdir $dir))
      (then (return (i32.const -9)))
      (else))

    (if (i32.ne (call $closedir $dir) (i32.const 0))
      (then (return (i32.const -10)))
      (else))

    (return (i32.const 100)))

  ;; ---------------------------------------------------------------------------
  ;; Part 2 & 3: Test `scandir`, `alphasort`, custom MARV callbacks, and `freelist`
  ;; Returns 200 on success, negative on failure.
  ;; ---------------------------------------------------------------------------
  (func $test_scandir_ops (export "test_scandir_ops")
    (param $verbose i32) (result i32)
    (frame 32)
    (local $tdir ptr)
    (local $n i32)
    (local $list ptr)
    (local $i i32)
    (local $ent ptr)
    (local $e0 ptr)
    (local $e1 ptr)
    (local $e2 ptr)
    (local $e3 ptr)

    (local.set $tdir (call $target_dir))

    (if (i32.ne $verbose (i32.const 0))
      (then
        (drop (call $puts (ref.data $hdr_banner)))
        (drop (call $puts (ref.data $hdr_scan1))))
      (else))

    ;; 1. Alphabetical scan: `scandir(tdir, &list, filter_mvs_or_dir, alphasort)`
    (local.set $n
      (call $scandir
        $tdir
        (frame.addr 0)
        (ref.func $filter_mvs_or_dir)
        (ref.func $alphasort)))
    (if (i32.ne $n (i32.const 4))
      (then (return (i32.const -20)))
      (else))

    ;; Load `namelist` pointer from 8-byte frame slot 0
    (local.set $list (ptr.load offset 0 (frame.addr 0)))

    (local.set $i (i32.const 0))
    (block $print1_done
      (loop $print1_lp
        (br_if $print1_done (i32.ge_s $i $n))
        ;; Uniform 8-byte pointer slot indexing: `list + (i << 3)`
        (local.set $ent (ptr.load (ptr.add $list (i32.shl $i (i32.const 3)))))
        (if (i32.ne $verbose (i32.const 0))
          (then (call $print_entry_line $i $ent))
          (else))
        (local.set $i (i32.add $i (i32.const 1)))
        (br $print1_lp)))

    ;; Verify exact alphabetical order of the 4 entries:
    ;;   dirent_demo.mvs, libc_demo.mvs, multimod, queens.mvs
    (local.set $e0 (ptr.load offset 0  $list))
    (local.set $e1 (ptr.load offset 8  $list))
    (local.set $e2 (ptr.load offset 16 $list))
    (local.set $e3 (ptr.load offset 24 $list))

    (if (i32.or
          (i32.or (i32.ne (call $strcmp (field.addr $dirent $d_name $e0) (ref.data $exp_d))   (i32.const 0))
                  (i32.ne (call $strcmp (field.addr $dirent $d_name $e1) (ref.data $exp_l))   (i32.const 0)))
          (i32.or (i32.ne (call $strcmp (field.addr $dirent $d_name $e2) (ref.data $exp_dir)) (i32.const 0))
                  (i32.ne (call $strcmp (field.addr $dirent $d_name $e3) (ref.data $exp_q))   (i32.const 0))))
      (then (return (i32.const -21)))
      (else))

    (call $freelist $list $n)

    ;; 2. Filtered & custom-sorted scan:
    ;;    `scandir(tdir, &list, filter_mvs_or_dir, cmp_by_len_asc)`
    (if (i32.ne $verbose (i32.const 0))
      (then (drop (call $puts (ref.data $hdr_scan2))))
      (else))

    (local.set $n
      (call $scandir
        $tdir
        (frame.addr 0)
        (ref.func $filter_mvs_or_dir)
        (ref.func $cmp_by_len_asc)))
    (if (i32.ne $n (i32.const 4))
      (then (return (i32.const -22)))
      (else))

    (local.set $list (ptr.load offset 0 (frame.addr 0)))

    (local.set $i (i32.const 0))
    (block $print2_done
      (loop $print2_lp
        (br_if $print2_done (i32.ge_s $i $n))
        (local.set $ent (ptr.load (ptr.add $list (i32.shl $i (i32.const 3)))))
        (if (i32.ne $verbose (i32.const 0))
          (then (call $print_entry_line $i $ent))
          (else))
        (local.set $i (i32.add $i (i32.const 1)))
        (br $print2_lp)))

    ;; Verify length-sorted order:
    ;;   "multimod" (8), "queens.mvs" (10), "libc_demo.mvs" (13), "dirent_demo.mvs" (15)
    (local.set $e0 (ptr.load offset 0  $list))
    (local.set $e1 (ptr.load offset 8  $list))
    (local.set $e2 (ptr.load offset 16 $list))
    (local.set $e3 (ptr.load offset 24 $list))

    (if (i32.or
          (i32.or (i32.ne (call $strcmp (field.addr $dirent $d_name $e0) (ref.data $exp_dir)) (i32.const 0))
                  (i32.ne (call $strcmp (field.addr $dirent $d_name $e1) (ref.data $exp_q))   (i32.const 0)))
          (i32.or (i32.ne (call $strcmp (field.addr $dirent $d_name $e2) (ref.data $exp_l))   (i32.const 0))
                  (i32.ne (call $strcmp (field.addr $dirent $d_name $e3) (ref.data $exp_d))   (i32.const 0))))
      (then (return (i32.const -23)))
      (else))

    (call $freelist $list $n)

    (if (i32.ne $verbose (i32.const 0))
      (then (drop (call $puts (ref.data $ftr_pass))))
      (else))

    (return (i32.const 200)))

  (func $main (export "main")
    (param $argc i32) (param $argv ptr) (result i32)
    (local $r1 i32)
    (local $r2 i32)
    (local.set $r1 (call $test_stream_ops))
    (if (i32.ne $r1 (i32.const 100))
      (then (return (i32.const 1)))
      (else))
    (local.set $r2 (call $test_scandir_ops (i32.const 1)))
    (if (i32.ne $r2 (i32.const 200))
      (then (return (i32.const 2)))
      (else))
    (return (i32.const 0))))
