static inline marv_i32 marv_ptr_ge_u(marv_ptr a, marv_ptr b) { return (uintptr_t)a >= (uintptr_t)b ? 1 : 0; }

static inline marv_ptr marv_ptr_of_i64(marv_i64 v) { return (marv_ptr)(uintptr_t)(uint64_t)v; }
