  return (marv_i32)((const uint8_t*)p1 - (const uint8_t*)p2);
}
static inline marv_i64 marv_ptr_diff64(marv_ptr p1, marv_ptr p2) {
  return (marv_i64)((const uint8_t*)p1 - (const uint8_t*)p2);
}

