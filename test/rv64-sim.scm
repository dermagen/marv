;; =============================================================================
;; rv64-sim.scm -- Lightweight RV64G User-Mode Assembly Simulator (R7RS / Skint)
;; Parses and executes RV64G assembly (.s) produced by MARV to verify register
;; allocation, unified stack frame layout, and instruction selection end-to-end.
;; =============================================================================

(define *rv-gp-names*
  '("zero" "ra" "sp" "gp" "tp"
    "t0" "t1" "t2"
    "s0" "s1"
    "a0" "a1" "a2" "a3" "a4" "a5" "a6" "a7"
    "s2" "s3" "s4" "s5" "s6" "s7" "s8" "s9" "s10" "s11"
    "t3" "t4" "t5" "t6"))

(define *rv-fp-names*
  '("ft0" "ft1" "ft2" "ft3" "ft4" "ft5" "ft6" "ft7"
    "fs0" "fs1"
    "fa0" "fa1" "fa2" "fa3" "fa4" "fa5" "fa6" "fa7"
    "fs2" "fs3" "fs4" "fs5" "fs6" "fs7" "fs8" "fs9" "fs10" "fs11"
    "ft8" "ft9" "ft10" "ft11"))

(define (rv-reg-index name names)
  (let loop ((l names) (i 0))
    (cond ((null? l) #f)
          ((string=? name (car l)) i)
          (else (loop (cdr l) (+ i 1))))))

(define (rv-gp-idx name) (rv-reg-index name *rv-gp-names*))
(define (rv-fp-idx name) (rv-reg-index name *rv-fp-names*))

;; Two's complement bit helpers (exact integers)
(define *pow2-31* 2147483648)
(define *pow2-32* 4294967296)
(define *pow2-63* 9223372036854775808)
(define *pow2-64* 18446744073709551616)

(define (u64 x) (modulo x *pow2-64*))
(define (s64 x)
  (let ((u (u64 x)))
    (if (>= u *pow2-63*) (- u *pow2-64*) u)))

(define (u32 x) (modulo x *pow2-32*))
(define (s32 x)
  (let ((u (u32 x)))
    (if (>= u *pow2-31*) (- u *pow2-32*) u)))

;; Bitwise operations on 64-bit unsigned integers
(define (bit-and64 a b)
  (let loop ((i 0) (ua (u64 a)) (ub (u64 b)) (bit 1) (acc 0))
    (if (= i 64)
        acc
        (loop (+ i 1)
              (quotient ua 2)
              (quotient ub 2)
              (* bit 2)
              (if (and (odd? ua) (odd? ub)) (+ acc bit) acc)))))

(define (bit-or64 a b)
  (let loop ((i 0) (ua (u64 a)) (ub (u64 b)) (bit 1) (acc 0))
    (if (= i 64)
        acc
        (loop (+ i 1)
              (quotient ua 2)
              (quotient ub 2)
              (* bit 2)
              (if (or (odd? ua) (odd? ub)) (+ acc bit) acc)))))

(define (bit-xor64 a b)
  (let loop ((i 0) (ua (u64 a)) (ub (u64 b)) (bit 1) (acc 0))
    (if (= i 64)
        acc
        (loop (+ i 1)
              (quotient ua 2)
              (quotient ub 2)
              (* bit 2)
              (if (not (eq? (odd? ua) (odd? ub))) (+ acc bit) acc)))))

;; Convert IEEE-754 64-bit integer bits back to a Scheme flonum

;; [cco] fcvt carries a rounding mode; the simulator used to truncate always,
;; so f64.nearest (which the backend lowers with rne) came out wrong.
(define (rv-round-mode x mode)
  (cond ((not mode) (truncate x))
        ((string=? mode "rtz") (truncate x))
        ((string=? mode "rne") (round x))        ; ties to even, as RISC-V rne
        ((string=? mode "rdn") (floor x))
        ((string=? mode "rup") (ceiling x))
        ((string=? mode "rmm") (if (< x 0.0) (- (floor (+ (- x) 0.5))) (floor (+ x 0.5))))
        (else (truncate x))))
(define (rv-cvt-mode ops) (and (pair? (cddr ops)) (caddr ops)))

(define (ieee32-bits->flonum bits)      ; [cco] single-precision pattern
  (let* ((b (modulo bits (expt 2 32)))
         (sign (if (>= b (expt 2 31)) -1.0 1.0))
         (e (quotient (modulo b (expt 2 31)) (expt 2 23)))
         (m (modulo b (expt 2 23))))
    (cond ((and (= e 255) (> m 0)) (/ 0. 0.))
          ((= e 255) (* sign (/ 1. 0.)))
          ((= e 0) (* sign (exact->inexact m) (expt 2.0 -149)))
          (else (* sign (+ 1.0 (* (exact->inexact m) (expt 2.0 -23)))
                   (expt 2.0 (- e 127)))))))

(define (ieee64-bits->flonum bits)
  (let* ((u (u64 bits))
         (s (quotient u *pow2-63*))
         (rem (modulo u *pow2-63*))
         (exp2 (quotient rem (expt 2 52)))
         (mant (modulo rem (expt 2 52)))
         (sign (if (= s 1) -1.0 1.0)))
    (cond
      ((= exp2 #x7ff)
       (if (= mant 0) (* sign +inf.0) +nan.0))
      ((= exp2 0)
       (if (= mant 0)
           (if (= s 1) -0.0 0.0)
           (* sign (inexact mant) (expt 2.0 -1074.0))))
      (else
       (* sign (+ 1.0 (* (inexact mant) (expt 2.0 -52.0)))
          (expt 2.0 (inexact (- exp2 1023))))))))

;; Simple line tokenizer for RV64G assembly
(define (rv-trim str)
  (let* ((len (string-length str))
         (i (let lp ((k 0))
              (if (and (< k len) (char-whitespace? (string-ref str k)))
                  (lp (+ k 1))
                  k)))
         (j (let lp ((k (- len 1)))
              (if (and (>= k i) (char-whitespace? (string-ref str k)))
                  (lp (- k 1))
                  (+ k 1)))))
    (substring str i j)))

(define (rv-strip-comment line)
  (let ((idx (string-index line #\#)))
    (if idx (substring line 0 idx) line)))

(define (rv-split-tokens str)
  (let ((len (string-length str)))
    (let loop ((i 0) (cur '()) (toks '()))
      (cond
        ((= i len)
         (let ((final (if (pair? cur) (cons (list->string (reverse cur)) toks) toks)))
           (reverse final)))
        ((let ((c (string-ref str i)))
           (or (char-whitespace? c) (char=? c #\,)))
         (if (pair? cur)
             (loop (+ i 1) '() (cons (list->string (reverse cur)) toks))
             (loop (+ i 1) '() toks)))
        (else
         (loop (+ i 1) (cons (string-ref str i) cur) toks))))))

;; Parse offset(base) e.g. "24(sp)" -> (cons 24 "sp")
(define (rv-parse-memop str)
  (let ((lp (string-index str #\())
        (rp (string-index str #\))))
    (if (and lp rp)
        (cons (string->number (substring str 0 lp))
              (substring str (+ lp 1) rp))
        (error "invalid memory operand" str))))

;; Load one or more RV64G .s files into a simulator state:
;; `filename-or-list` may be a single path string or a list of path strings.
;; Returns: (vector mem data-syms code-vec func-labels data-ptr)
(define (rv64-load-asm filename-or-list)
  (let ((filenames (if (pair? filename-or-list) filename-or-list (list filename-or-list)))
        (mem (make-bytevector 131072 0))
        (data-ptr 4096) ;; static data starts at 0x1000
        (data-syms '(("stdin"       . #x0800)
                     ("stdout"      . #x0808)
                     ("stderr"      . #x0810)
                     ("errno_errno" . #x0818)
                     ("stdio__iob"  . #x7000)))
        (data-relocs '()) ;; list of (addr sym off)
        (code-list '())
        (code-labels '(("dirent_alphasort" . -100)))
        (section 'text))

    ;; Initialize libc global FILE* variables (`stdin`, `stdout`, `stderr`) in low memory
    (let ((init-ptr! (lambda (addr val)
                       (let lp ((bs (int->le-bytes val 8)) (i 0))
                         (when (pair? bs)
                           (bytevector-u8-set! mem (+ addr i) (car bs))
                           (lp (cdr bs) (+ i 1)))))))
      (init-ptr! #x0800 #x7000)
      (init-ptr! #x0808 #x7020)
      (init-ptr! #x0810 #x7040))

    (define (align-data! p2)
      (let ((a (expt 2 p2)))
        (set! data-ptr (align-up data-ptr a))))

    (for-each
      (lambda (filename)
        (set! section 'text)
        (call-with-input-file filename
          (lambda (port)
            (let loop ()
              (let ((line (read-line port)))
                (when (not (eof-object? line))
                  (let* ((clean (rv-trim (rv-strip-comment line)))
                         (len (string-length clean)))
                    (when (> len 0)
                      (cond
                        ;; Label definition: foo:
                        ((char=? (string-ref clean (- len 1)) #\:)
                         (let ((lbl (substring clean 0 (- len 1))))
                           (if (eq? section 'text)
                               (set! code-labels (cons (cons lbl (length code-list)) code-labels))
                               (set! data-syms (cons (cons lbl data-ptr) data-syms)))))

                        (else
                         (let* ((toks (rv-split-tokens clean))
                                (op (car toks))
                                (args (cdr toks)))
                           (cond
                             ((string=? op ".text")
                              (set! section 'text))
                             ((or (string=? op ".data")
                                  (and (string=? op ".section")
                                       (pair? args)
                                       (or (string=? (car args) ".rodata")
                                           (string=? (car args) ".data"))))
                              (set! section 'data))
                             ((string=? op ".p2align")
                              (when (eq? section 'data)
                                (align-data! (string->number (car args)))))
                             ((or (string=? op ".option")
                                  (string=? op ".attribute")
                                  (string=? op ".globl")
                                  (string=? op ".weak")
                                  (string=? op ".section"))
                              #f)
                             ((string=? op ".byte")
                              (let ((b (modulo (string->number (car args)) 256)))
                                (bytevector-u8-set! mem data-ptr b)
                                (set! data-ptr (+ data-ptr 1))))
                             ((string=? op ".word")
                              (let ((bs (int->le-bytes (string->number (car args)) 4)))
                                (for-each (lambda (b)
                                            (bytevector-u8-set! mem data-ptr b)
                                            (set! data-ptr (+ data-ptr 1)))
                                          bs)))
                             ((string=? op ".dword")
                              (let ((n (string->number (car args))))
                                (if n
                                    (let ((bs (int->le-bytes n 8)))
                                      (for-each (lambda (b)
                                                  (bytevector-u8-set! mem data-ptr b)
                                                  (set! data-ptr (+ data-ptr 1)))
                                                bs))
                                    ;; Symbolic relocation: .dword sym [+ off]
                                    (let ((sym (car args))
                                          (off (if (and (= (length args) 3) (string=? (cadr args) "+"))
                                                   (string->number (caddr args))
                                                   0)))
                                      (set! data-relocs (cons (list data-ptr sym off) data-relocs))
                                      (set! data-ptr (+ data-ptr 8))))))
                             ((string=? op ".zero")
                              (set! data-ptr (+ data-ptr (string->number (car args)))))
                             (else
                              ;; Instruction in .text
                              (set! code-list (cons (cons op args) code-list)))))))))
                  (loop)))))))
      filenames)

    ;; Apply static data relocations
    (for-each
      (lambda (rel)
        (let* ((addr (list-ref rel 0))
               (sym (list-ref rel 1))
               (off (list-ref rel 2))
               (target (or (assoc sym data-syms) (assoc sym code-labels)))
               (tval (+ (if target (cdr target) 0) off))
               (bs (int->le-bytes tval 8)))
          (let blp ((l bs) (i 0))
            (when (pair? l)
              (bytevector-u8-set! mem (+ addr i) (car l))
              (blp (cdr l) (+ i 1))))))
      data-relocs)

    (vector mem data-syms (list->vector (reverse code-list)) code-labels data-ptr)))

;; Memory load/store helpers on simulator bytevector

;; [cco] RISC-V float helpers: the sign of zero matters, and fmin/fmax return
;; the non-NaN operand rather than propagating NaN.
(define (flnan-rv? x) (not (= x x)))
(define (flnegative-rv x)             ; true for -0.0 as well as negatives
  (or (< x 0.0) (and (= x 0.0) (< (/ 1.0 x) 0.0))))
(define (flmin-rv a b)
  (cond ((flnan-rv? a) b) ((flnan-rv? b) a)
        ((= a b) (if (flnegative-rv a) a b))   ; -0.0 is the smaller zero
        ((< a b) a) (else b)))
(define (flmax-rv a b)
  (cond ((flnan-rv? a) b) ((flnan-rv? b) a)
        ((= a b) (if (flnegative-rv a) b a))
        ((> a b) a) (else b)))
(define (flcopysign-rv a b)
  (let ((m (if (flnegative-rv a) (- a) a)))
    (if (flnegative-rv b) (- m) m)))

(define (sim-load-u mem addr nbytes)
  (let loop ((i (- nbytes 1)) (acc 0))
    (if (< i 0)
        acc
        (loop (- i 1) (+ (* acc 256) (bytevector-u8-ref mem (+ addr i)))))))

(define (sim-load-s mem addr nbytes)
  (let ((u (sim-load-u mem addr nbytes))
        (half (expt 2 (- (* nbytes 8) 1)))
        (full (expt 2 (* nbytes 8))))
    (if (>= u half) (- u full) u)))

(define (sim-store! mem addr val nbytes)
  (let ((bs (int->le-bytes val nbytes)))
    (let loop ((l bs) (i 0))
      (when (pair? l)
        (bytevector-u8-set! mem (+ addr i) (car l))
        (loop (cdr l) (+ i 1))))))

;; Maximum stack bytes used during the most recent `rv64-call`
(define *rv64-last-max-stack-bytes* 0)

;; Read NUL-terminated C string from simulator memory
(define (sim-read-cstring mem addr)
  (let loop ((p addr) (chars '()))
    (let ((b (bytevector-u8-ref mem p)))
      (if (= b 0)
          (list->string (reverse chars))
          (loop (+ p 1) (cons (integer->char b) chars))))))

;; Format a minimal printf/snprintf string for RV64G simulator
(define (sim-format-snprintf mem fmt-addr get-next-varg!)
  (let ((fmt (sim-read-cstring mem fmt-addr))
        (out (open-output-string)))
    (let ((len (string-length fmt)))
      (let loop ((i 0))
        (if (>= i len)
            (get-output-string out)
            (let ((ch (string-ref fmt i)))
              (if (not (char=? ch #\%))
                  (begin (write-char ch out) (loop (+ i 1)))
                  (let parse-spec ((j (+ i 1)) (prec #f))
                    (if (>= j len)
                        (get-output-string out)
                        (let ((sc (string-ref fmt j)))
                          (cond
                            ((char=? sc #\%)
                             (write-char #\% out)
                             (loop (+ j 1)))
                            ((char=? sc #\.)
                             (let dloop ((k (+ j 1)) (p 0))
                               (if (and (< k len) (char-numeric? (string-ref fmt k)))
                                   (dloop (+ k 1) (+ (* p 10) (- (char->integer (string-ref fmt k)) 48)))
                                   (parse-spec k p))))
                            ((or (char=? sc #\l) (char=? sc #\z) (char=? sc #\h)
                                 (char-numeric? sc))
                             (parse-spec (+ j 1) prec))
                            ((or (char=? sc #\x) (char=? sc #\X))
                             (let* ((raw (get-next-varg!))
                                    (val (u32 raw))
                                    (hex (number->string val 16))
                                    (uhex (if (char=? sc #\X)
                                              (list->string
                                                (map (lambda (c)
                                                       (if (and (char>=? c #\a) (char<=? c #\f))
                                                           (integer->char (- (char->integer c) 32))
                                                           c))
                                                     (string->list hex)))
                                              hex))
                                    (hlen (string-length uhex))
                                    (pad (if (and (> j (+ i 1))
                                                  (char=? (string-ref fmt (+ i 1)) #\0)
                                                  (char=? (string-ref fmt (+ i 2)) #\8))
                                             (max 0 (- 8 hlen))
                                             0)))
                               (let plp ((k 0))
                                 (when (< k pad)
                                   (write-char #\0 out)
                                   (plp (+ k 1))))
                               (display uhex out)
                               (loop (+ j 1))))
                            ((or (char=? sc #\d) (char=? sc #\i))
                             (let* ((raw (get-next-varg!))
                                    (is-long? (and (> j (+ i 1))
                                                   (or (char=? (string-ref fmt (- j 1)) #\l)
                                                       (char=? (string-ref fmt (- j 1)) #\z))))
                                    (val (if is-long? (s64 raw) (s32 raw))))
                               (display (number->string val) out)
                               (loop (+ j 1))))
                            ((char=? sc #\u)
                             (let* ((raw (get-next-varg!))
                                    (is-long? (and (> j (+ i 1))
                                                   (or (char=? (string-ref fmt (- j 1)) #\l)
                                                       (char=? (string-ref fmt (- j 1)) #\z))))
                                    (val (if is-long? (u64 raw) (u32 raw))))
                               (display (number->string val) out)
                               (loop (+ j 1))))
                            ((char=? sc #\s)
                             (let ((saddr (get-next-varg!)))
                               (display (sim-read-cstring mem saddr) out)
                               (loop (+ j 1))))
                            ((char=? sc #\f)
                             (let* ((raw (get-next-varg!))
                                    (fv (ieee64-bits->flonum raw)))
                               (if (and prec (= prec 2))
                                   (let* ((neg? (< fv 0.0))
                                          (afv (abs fv))
                                          (scaled (exact (round (* afv 100.0))))
                                          (ip (quotient scaled 100))
                                          (fp (remainder scaled 100)))
                                     (when neg? (write-char #\- out))
                                     (display (number->string ip) out)
                                     (write-char #\. out)
                                     (when (< fp 10) (write-char #\0 out))
                                     (display (number->string fp) out))
                                   (display (number->string fv) out))
                               (loop (+ j 1))))
                            (else
                             (write-char sc out)
                             (loop (+ j 1))))))))))))))

;; Call a function in the loaded RV64G simulator
;; args is a list of numbers (exact integers for GP, inexact flonums for FP)
(define (rv64-call sim func-name args . ret-float?)
  (let* ((mem (vector-ref sim 0))
         (data-syms (vector-ref sim 1))
         (code-vec (vector-ref sim 2))
         (code-labels (vector-ref sim 3))
         (gp (make-vector 32 0))
         (fp (make-vector 32 0.0))
         (entry (assoc func-name code-labels))
         (init-sp #x1F000)
         (min-sp #x1F000)
         (heap-ptr #x8000)
         (sim-errno 0)
         (get-gp (lambda (rname)
                   (let ((idx (rv-gp-idx rname)))
                     (if (= idx 0) 0 (vector-ref gp idx)))))
         (set-gp! (lambda (rname val)
                    (let ((idx (rv-gp-idx rname))
                          (sval (s64 val)))
                      (when (> idx 0)
                        (vector-set! gp idx sval)
                        (when (and (= idx 2) (< sval min-sp))
                          (set! min-sp sval))))))
         (get-fp (lambda (rname)
                   (vector-ref fp (rv-fp-idx rname))))
         (set-fp! (lambda (rname val)
                    (vector-set! fp (rv-fp-idx rname) (inexact val))))
         (resolve-sym (lambda (sym)
                        (let ((d (assoc sym data-syms))
                              (c (assoc sym code-labels)))
                          (cond (d (cdr d))
                                (c (cdr c))
                                (else (error "unknown symbol in RV64G sim" sym)))))))
    (if (not entry)
        (error "function not found in RV64G assembly" func-name)
        (begin
          ;; Initialize sp to top of 128KB memory (0x1F000) and ra to sentinel -1
          (vector-set! gp 2 init-sp)
          (vector-set! gp 1 -1)

          ;; Populate argument registers a0..a7 (gp 10..17) and fa0..fa7 (fp 10..17)
          (let aloop ((as args) (gi 10) (fi 10))
            (when (pair? as)
              (let ((a (car as)))
                (if (and (inexact? a) (flonum? a))
                    (begin
                      (vector-set! fp fi a)
                      (aloop (cdr as) gi (+ fi 1)))
                    (begin
                      (vector-set! gp gi (s64 a))
                      (aloop (cdr as) (+ gi 1) fi))))))

          ;; Execute instructions starting at entry PC
          (let run ((pc (cdr entry)))
            (if (< pc 0)
                ;; Returned from call (or callback subcall when pc = -2)!
                (begin
                  (when (= pc -1)
                    (set! *rv64-last-max-stack-bytes* (- init-sp min-sp)))
                  (if (and (= pc -1) (pair? ret-float?) (car ret-float?))
                      (vector-ref fp 10) ;; fa0
                      (vector-ref gp 10))) ;; a0
                (let* ((ins (vector-ref code-vec pc))
                       (op (car ins))
                       (ops (cdr ins))
                       (next-pc (+ pc 1)))

                  ;; Helper to invoke an RV64G callback procedure `(cb-pc arg0 arg1)` from simulated libc
                  (define (invoke-rv64-callback cb-pc a0-val a1-val)
                    (if (= cb-pc -100)
                        ;; External `dirent_alphasort(da, db)` where `da` and `db` are `struct dirent **`
                        ;; (8-byte pointer slots pointing to `struct dirent` where `d_name` is at offset +9)
                        (let* ((ea (sim-load-u mem a0-val 8))
                               (eb (sim-load-u mem a1-val 8))
                               (sa (sim-read-cstring mem (+ ea 9)))
                               (sb (sim-read-cstring mem (+ eb 9))))
                          (cond ((string<? sa sb) -1)
                                ((string>? sa sb)  1)
                                (else 0)))
                        (let ((saved-ra (vector-ref gp 1))
                              (saved-a0 (vector-ref gp 10))
                              (saved-a1 (vector-ref gp 11))
                              (saved-a2 (vector-ref gp 12))
                              (saved-a3 (vector-ref gp 13))
                              (saved-a4 (vector-ref gp 14))
                              (saved-a5 (vector-ref gp 15)))
                          (vector-set! gp 1 -2)
                          (vector-set! gp 10 (s64 a0-val))
                          (vector-set! gp 11 (s64 a1-val))
                          (let ((res (s32 (run cb-pc))))
                            (vector-set! gp 1 saved-ra)
                            (vector-set! gp 10 saved-a0)
                            (vector-set! gp 11 saved-a1)
                            (vector-set! gp 12 saved-a2)
                            (vector-set! gp 13 saved-a3)
                            (vector-set! gp 14 saved-a4)
                            (vector-set! gp 15 saved-a5)
                            res))))

                  (cond
                    ;; Moves & constants
                    ((string=? op "li")
                     (set-gp! (car ops) (string->number (cadr ops)))
                     (run next-pc))
                    ((string=? op "la")
                     (let ((base (resolve-sym (cadr ops)))
                           (off (if (and (= (length ops) 4) (string=? (caddr ops) "+"))
                                    (string->number (cadddr ops))
                                    0)))
                       (set-gp! (car ops) (+ base off))
                       (run next-pc)))
                    ((string=? op "mv")
                     (set-gp! (car ops) (get-gp (cadr ops)))
                     (run next-pc))
                    ((or (string=? op "fmv.d") (string=? op "fmv.s"))
                     (set-fp! (car ops) (get-fp (cadr ops)))
                     (run next-pc))
                    ((string=? op "fmv.d.x")
                     (let ((bits (get-gp (cadr ops))))
                       (set-fp! (car ops) (if (= bits 0) 0.0 (ieee64-bits->flonum bits)))
                       (run next-pc)))
                    ((string=? op "fmv.w.x")      ; [cco] 32-bit pattern, not 64
                     (set-fp! (car ops) (ieee32-bits->flonum (get-gp (cadr ops))))
                     (run next-pc))
                    ((string=? op "fmv.x.d")
                     (set-gp! (car ops) (flonum->ieee64-bits (get-fp (cadr ops))))
                     (run next-pc))
                    ((string=? op "fmv.x.w")      ; [cco] 32 bits, sign-extended
                     (set-gp! (car ops) (s32 (flonum->ieee32-bits (get-fp (cadr ops)))))
                     (run next-pc))

                    ;; Memory Loads
                    ((member op '("lb" "lbu" "lh" "lhu" "lw" "lwu" "ld" "flw" "fld"))
                     (let* ((rd (car ops))
                            (mp (rv-parse-memop (cadr ops)))
                            (addr (+ (get-gp (cdr mp)) (car mp))))
                       (cond
                         ((string=? op "lb")  (set-gp! rd (sim-load-s mem addr 1)))
                         ((string=? op "lbu") (set-gp! rd (sim-load-u mem addr 1)))
                         ((string=? op "lh")  (set-gp! rd (sim-load-s mem addr 2)))
                         ((string=? op "lhu") (set-gp! rd (sim-load-u mem addr 2)))
                         ((string=? op "lw")  (set-gp! rd (sim-load-s mem addr 4)))
                         ((string=? op "lwu") (set-gp! rd (sim-load-u mem addr 4)))
                         ((string=? op "ld")  (set-gp! rd (sim-load-s mem addr 8)))
                         ((string=? op "flw") (set-fp! rd (ieee32-bits->flonum (sim-load-u mem addr 4))))  ; [cco]
                         ((string=? op "fld") (set-fp! rd (ieee64-bits->flonum (sim-load-u mem addr 8)))))
                       (run next-pc)))

                    ;; Memory Stores
                    ((member op '("sb" "sh" "sw" "sd" "fsw" "fsd"))
                     (let* ((rs (car ops))
                            (mp (rv-parse-memop (cadr ops)))
                            (addr (+ (get-gp (cdr mp)) (car mp))))
                       (cond
                         ((string=? op "sb")  (sim-store! mem addr (get-gp rs) 1))
                         ((string=? op "sh")  (sim-store! mem addr (get-gp rs) 2))
                         ((string=? op "sw")  (sim-store! mem addr (get-gp rs) 4))
                         ((string=? op "sd")  (sim-store! mem addr (get-gp rs) 8))
                         ((string=? op "fsw") (sim-store! mem addr (flonum->ieee32-bits (get-fp rs)) 4))  ; [cco]
                         ((string=? op "fsd") (sim-store! mem addr (flonum->ieee64-bits (get-fp rs)) 8)))
                       (run next-pc)))

                    ;; Immediate ALU
                    ((string=? op "addi")
                     (set-gp! (car ops) (+ (get-gp (cadr ops)) (string->number (caddr ops))))
                     (run next-pc))
                    ((string=? op "addiw")
                     (set-gp! (car ops) (s32 (+ (get-gp (cadr ops)) (string->number (caddr ops)))))
                     (run next-pc))
                    ((string=? op "andi")
                     (set-gp! (car ops) (bit-and64 (get-gp (cadr ops)) (string->number (caddr ops))))
                     (run next-pc))
                    ((string=? op "ori")
                     (set-gp! (car ops) (bit-or64 (get-gp (cadr ops)) (string->number (caddr ops))))
                     (run next-pc))
                    ((string=? op "xori")
                     (set-gp! (car ops) (bit-xor64 (get-gp (cadr ops)) (string->number (caddr ops))))
                     (run next-pc))
                    ((string=? op "slli")
                     (set-gp! (car ops) (* (get-gp (cadr ops)) (expt 2 (modulo (string->number (caddr ops)) 64))))
                     (run next-pc))
                    ((string=? op "slliw")
                     (set-gp! (car ops) (s32 (* (u32 (get-gp (cadr ops))) (expt 2 (modulo (string->number (caddr ops)) 32)))))
                     (run next-pc))
                    ((string=? op "srli")
                     (set-gp! (car ops) (quotient (u64 (get-gp (cadr ops))) (expt 2 (modulo (string->number (caddr ops)) 64))))
                     (run next-pc))
                    ((string=? op "srliw")
                     (set-gp! (car ops) (s32 (quotient (u32 (get-gp (cadr ops))) (expt 2 (modulo (string->number (caddr ops)) 32)))))
                     (run next-pc))
                    ((string=? op "srai")
                     (set-gp! (car ops) (floor-quotient (s64 (get-gp (cadr ops))) (expt 2 (modulo (string->number (caddr ops)) 64))))
                     (run next-pc))
                    ((string=? op "sraiw")
                     (set-gp! (car ops) (s32 (floor-quotient (s32 (get-gp (cadr ops))) (expt 2 (modulo (string->number (caddr ops)) 32)))))
                     (run next-pc))
                    ((string=? op "slti")
                     (set-gp! (car ops) (if (< (s64 (get-gp (cadr ops))) (string->number (caddr ops))) 1 0))
                     (run next-pc))
                    ((string=? op "sltiu")
                     (set-gp! (car ops) (if (< (u64 (get-gp (cadr ops))) (u64 (string->number (caddr ops)))) 1 0))
                     (run next-pc))

                    ;; Register ALU (32-bit *w and 64-bit)
                    ;; [cco] emitted by i32.rotl/rotr, f64.min/max and f64.copysign
                    ((string=? op "negw")
                     (set-gp! (car ops) (s32 (- (s32 (get-gp (cadr ops))))))
                     (run next-pc))
                    ((string=? op "neg")
                     (set-gp! (car ops) (- (get-gp (cadr ops))))
                     (run next-pc))
                    ((string=? op "fmin.d")
                     (set-fp! (car ops) (flmin-rv (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fmax.d")
                     (set-fp! (car ops) (flmax-rv (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fsgnj.d")      ; copysign
                     (set-fp! (car ops) (flcopysign-rv (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fsgnjn.d")     ; copysign with the sign negated
                     (set-fp! (car ops) (flcopysign-rv (get-fp (cadr ops))
                                                       (- (get-fp (caddr ops)))))
                     (run next-pc))
                    ((string=? op "fsgnjx.d")     ; xor of the signs
                     (set-fp! (car ops)
                              (flcopysign-rv (get-fp (cadr ops))
                                             (* (if (flnegative-rv (get-fp (cadr ops))) -1.0 1.0)
                                                (get-fp (caddr ops)))))
                     (run next-pc))
                    ((string=? op "add")
                     (set-gp! (car ops) (+ (get-gp (cadr ops)) (get-gp (caddr ops))))
                     (run next-pc))
                    ((string=? op "addw")
                     (set-gp! (car ops) (s32 (+ (s32 (get-gp (cadr ops))) (s32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "sub")
                     (set-gp! (car ops) (- (get-gp (cadr ops)) (get-gp (caddr ops))))
                     (run next-pc))
                    ((string=? op "subw")
                     (set-gp! (car ops) (s32 (- (s32 (get-gp (cadr ops))) (s32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "mul")
                     (set-gp! (car ops) (* (get-gp (cadr ops)) (get-gp (caddr ops))))
                     (run next-pc))
                    ((string=? op "mulw")
                     (set-gp! (car ops) (s32 (* (s32 (get-gp (cadr ops))) (s32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "divw")
                     (set-gp! (car ops) (s32 (truncate-quotient (s32 (get-gp (cadr ops))) (s32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "divuw")
                     (set-gp! (car ops) (s32 (quotient (u32 (get-gp (cadr ops))) (u32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "remw")
                     (set-gp! (car ops) (s32 (truncate-remainder (s32 (get-gp (cadr ops))) (s32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "remuw")
                     (set-gp! (car ops) (s32 (remainder (u32 (get-gp (cadr ops))) (u32 (get-gp (caddr ops))))))
                     (run next-pc))
                    ((string=? op "and")
                     (set-gp! (car ops) (bit-and64 (get-gp (cadr ops)) (get-gp (caddr ops))))
                     (run next-pc))
                    ((string=? op "or")
                     (set-gp! (car ops) (bit-or64 (get-gp (cadr ops)) (get-gp (caddr ops))))
                     (run next-pc))
                    ((string=? op "xor")
                     (set-gp! (car ops) (bit-xor64 (get-gp (cadr ops)) (get-gp (caddr ops))))
                     (run next-pc))
                    ((string=? op "sll")
                     (set-gp! (car ops) (* (u64 (get-gp (cadr ops))) (expt 2 (modulo (u64 (get-gp (caddr ops))) 64))))
                     (run next-pc))
                    ((string=? op "sllw")
                     (set-gp! (car ops) (s32 (* (u32 (get-gp (cadr ops))) (expt 2 (modulo (u32 (get-gp (caddr ops))) 32)))))
                     (run next-pc))
                    ((string=? op "srl")
                     (set-gp! (car ops) (quotient (u64 (get-gp (cadr ops))) (expt 2 (modulo (u64 (get-gp (caddr ops))) 64))))
                     (run next-pc))
                    ((string=? op "srlw")
                     (set-gp! (car ops) (s32 (quotient (u32 (get-gp (cadr ops))) (expt 2 (modulo (u32 (get-gp (caddr ops))) 32)))))
                     (run next-pc))
                    ((string=? op "sra")
                     (set-gp! (car ops) (floor-quotient (s64 (get-gp (cadr ops))) (expt 2 (modulo (u64 (get-gp (caddr ops))) 64))))
                     (run next-pc))
                    ((string=? op "sraw")
                     (set-gp! (car ops) (s32 (floor-quotient (s32 (get-gp (cadr ops))) (expt 2 (modulo (u32 (get-gp (caddr ops))) 32)))))
                     (run next-pc))
                    ((string=? op "div")
                     (set-gp! (car ops) (truncate-quotient (s64 (get-gp (cadr ops))) (s64 (get-gp (caddr ops)))))
                     (run next-pc))
                    ((string=? op "divu")
                     (set-gp! (car ops) (quotient (u64 (get-gp (cadr ops))) (u64 (get-gp (caddr ops)))))
                     (run next-pc))
                    ((string=? op "rem")
                     (set-gp! (car ops) (truncate-remainder (s64 (get-gp (cadr ops))) (s64 (get-gp (caddr ops)))))
                     (run next-pc))
                    ((string=? op "remu")
                     (set-gp! (car ops) (remainder (u64 (get-gp (cadr ops))) (u64 (get-gp (caddr ops)))))
                     (run next-pc))
                    ((string=? op "slt")
                     (set-gp! (car ops) (if (< (s64 (get-gp (cadr ops))) (s64 (get-gp (caddr ops)))) 1 0))
                     (run next-pc))
                    ((string=? op "sltu")
                     (set-gp! (car ops) (if (< (u64 (get-gp (cadr ops))) (u64 (get-gp (caddr ops)))) 1 0))
                     (run next-pc))
                    ((string=? op "seqz")
                     (set-gp! (car ops) (if (= (get-gp (cadr ops)) 0) 1 0))
                     (run next-pc))
                    ((string=? op "snez")
                     (set-gp! (car ops) (if (not (= (get-gp (cadr ops)) 0)) 1 0))
                     (run next-pc))

                    ;; Floating-Point ALU
                    ((string=? op "fadd.d")
                     (set-fp! (car ops) (fl+ (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fsub.d")
                     (set-fp! (car ops) (fl- (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fmul.d")
                     (set-fp! (car ops) (fl* (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fdiv.d")
                     (set-fp! (car ops) (fl/ (get-fp (cadr ops)) (get-fp (caddr ops))))
                     (run next-pc))
                    ((string=? op "fsqrt.d")
                     (set-fp! (car ops) (flsqrt (get-fp (cadr ops))))
                     (run next-pc))
                    ((or (string=? op "feq.d") (string=? op "feq.s"))
                     (set-gp! (car ops) (if (fl=? (get-fp (cadr ops)) (get-fp (caddr ops))) 1 0))
                     (run next-pc))
                    ((or (string=? op "flt.d") (string=? op "flt.s"))
                     (set-gp! (car ops) (if (fl<? (get-fp (cadr ops)) (get-fp (caddr ops))) 1 0))
                     (run next-pc))
                    ((or (string=? op "fle.d") (string=? op "fle.s"))
                     (set-gp! (car ops) (if (fl<=? (get-fp (cadr ops)) (get-fp (caddr ops))) 1 0))
                     (run next-pc))
                    ((or (string=? op "fcvt.d.w") (string=? op "fcvt.s.w"))
                     (set-fp! (car ops) (inexact (s32 (get-gp (cadr ops)))))
                     (run next-pc))
                    ((or (string=? op "fcvt.d.wu") (string=? op "fcvt.s.wu"))
                     (set-fp! (car ops) (inexact (u32 (get-gp (cadr ops)))))
                     (run next-pc))
                    ((or (string=? op "fcvt.d.l") (string=? op "fcvt.s.l"))
                     (set-fp! (car ops) (inexact (s64 (get-gp (cadr ops)))))
                     (run next-pc))
                    ((or (string=? op "fcvt.d.lu") (string=? op "fcvt.s.lu"))
                     (set-fp! (car ops) (inexact (u64 (get-gp (cadr ops)))))
                     (run next-pc))
                    ((or (string=? op "fcvt.w.d") (string=? op "fcvt.w.s"))
                     (set-gp! (car ops) (s32 (exact (rv-round-mode (get-fp (cadr ops)) (rv-cvt-mode ops)))))
                     (run next-pc))
                    ((or (string=? op "fcvt.wu.d") (string=? op "fcvt.wu.s"))
                     (set-gp! (car ops) (s32 (u32 (exact (rv-round-mode (get-fp (cadr ops)) (rv-cvt-mode ops))))))
                     (run next-pc))
                    ((or (string=? op "fcvt.l.d") (string=? op "fcvt.l.s"))
                     (set-gp! (car ops) (s64 (exact (rv-round-mode (get-fp (cadr ops)) (rv-cvt-mode ops)))))
                     (run next-pc))
                    ((or (string=? op "fcvt.lu.d") (string=? op "fcvt.lu.s"))
                     (set-gp! (car ops) (u64 (exact (rv-round-mode (get-fp (cadr ops)) (rv-cvt-mode ops)))))
                     (run next-pc))

                    ;; Branches & Calls
                    ((string=? op "j")
                     (run (resolve-sym (car ops))))
                    ((string=? op "beqz")
                     (if (= (get-gp (car ops)) 0)
                         (run (resolve-sym (cadr ops)))
                         (run next-pc)))
                    ((string=? op "bnez")
                     (if (not (= (get-gp (car ops)) 0))
                         (run (resolve-sym (cadr ops)))
                         (run next-pc)))
                    ((string=? op "bltz")
                     (if (< (s64 (get-gp (car ops))) 0)
                         (run (resolve-sym (cadr ops)))
                         (run next-pc)))
                    ((string=? op "beq")
                     (if (= (get-gp (car ops)) (get-gp (cadr ops)))
                         (run (resolve-sym (caddr ops)))
                         (run next-pc)))
                    ((string=? op "bne")
                     (if (not (= (get-gp (car ops)) (get-gp (cadr ops))))
                         (run (resolve-sym (caddr ops)))
                         (run next-pc)))
                    ((string=? op "call")
                     (let* ((sym (car ops))
                            (local-lbl (assoc sym code-labels)))
                       (if local-lbl
                           (begin
                             (set-gp! "ra" next-pc)
                             (run (cdr local-lbl)))
                           ;; Simulated external libc / marv_ffi_shim procedure
                           (let ((a0 (get-gp "a0"))
                                 (a1 (get-gp "a1"))
                                 (a2 (get-gp "a2"))
                                 (a3 (get-gp "a3"))
                                 (a4 (get-gp "a4"))
                                 (fa0 (get-fp "fa0")))
                             (cond
                               ((or (string=? sym "malloc") (string=? sym "stdlib_malloc"))
                                (let* ((sz (max 8 (u64 a0)))
                                       (aligned-sz (align-up sz 16))
                                       (ptr (+ heap-ptr 16)))
                                  (sim-store! mem (+ heap-ptr 8) sz 8)
                                  (set! heap-ptr (+ ptr aligned-sz))
                                  (set-gp! "a0" ptr)
                                  (run next-pc)))

                               ((or (string=? sym "calloc") (string=? sym "stdlib_calloc"))
                                (let* ((tot (* (u64 a0) (u64 a1)))
                                       (sz (max 8 tot))
                                       (aligned-sz (align-up sz 16))
                                       (ptr (+ heap-ptr 16)))
                                  (sim-store! mem (+ heap-ptr 8) tot 8)
                                  (let zlp ((i 0))
                                    (when (< i aligned-sz)
                                      (bytevector-u8-set! mem (+ ptr i) 0)
                                      (zlp (+ i 1))))
                                  (set! heap-ptr (+ ptr aligned-sz))
                                  (set-gp! "a0" ptr)
                                  (run next-pc)))

                               ((or (string=? sym "realloc") (string=? sym "stdlib_realloc"))
                                (let* ((old-ptr a0)
                                       (new-sz (max 8 (u64 a1)))
                                       (aligned-sz (align-up new-sz 16))
                                       (new-ptr (+ heap-ptr 16)))
                                  (sim-store! mem (+ heap-ptr 8) new-sz 8)
                                  (set! heap-ptr (+ new-ptr aligned-sz))
                                  (when (> old-ptr 0)
                                    (let* ((old-sz (sim-load-u mem (- old-ptr 8) 8))
                                           (copy-n (min old-sz new-sz)))
                                      (let clp ((i 0))
                                        (when (< i copy-n)
                                          (bytevector-u8-set! mem (+ new-ptr i)
                                                              (bytevector-u8-ref mem (+ old-ptr i)))
                                          (clp (+ i 1))))))
                                  (set-gp! "a0" new-ptr)
                                  (run next-pc)))

                               ((or (string=? sym "free") (string=? sym "stdlib_free"))
                                (run next-pc))

                               ((or (string=? sym "memcpy") (string=? sym "string_memcpy") (string=? sym "string_memmove"))
                                (let ((dst a0) (src a1) (n (u64 a2)))
                                  (let clp ((i 0))
                                    (when (< i n)
                                      (bytevector-u8-set! mem (+ dst i)
                                                          (bytevector-u8-ref mem (+ src i)))
                                      (clp (+ i 1))))
                                  (set-gp! "a0" dst)
                                  (run next-pc)))

                               ((or (string=? sym "memset") (string=? sym "string_memset"))
                                (let ((dst a0) (b (modulo (u64 a1) 256)) (n (u64 a2)))
                                  (let mlp ((i 0))
                                    (when (< i n)
                                      (bytevector-u8-set! mem (+ dst i) b)
                                      (mlp (+ i 1))))
                                  (set-gp! "a0" dst)
                                  (run next-pc)))

                               ((or (string=? sym "memcmp") (string=? sym "string_memcmp"))
                                (let ((s1 a0) (s2 a1) (n (u64 a2)))
                                  (let mlp ((i 0))
                                    (if (>= i n)
                                        (begin (set-gp! "a0" 0) (run next-pc))
                                        (let ((b1 (bytevector-u8-ref mem (+ s1 i)))
                                              (b2 (bytevector-u8-ref mem (+ s2 i))))
                                          (if (= b1 b2)
                                              (mlp (+ i 1))
                                              (begin
                                                (set-gp! "a0" (- b1 b2))
                                                (run next-pc))))))))

                               ((or (string=? sym "strlen") (string=? sym "string_strlen"))
                                (let slp ((i 0))
                                  (if (= (bytevector-u8-ref mem (+ a0 i)) 0)
                                      (begin (set-gp! "a0" i) (run next-pc))
                                      (slp (+ i 1)))))

                               ((or (string=? sym "qsort") (string=? sym "stdlib_qsort"))
                                ;; Insertion sort on `mem` invoking the RV64G comparator callback at `a3`
                                (let ((base a0)
                                      (nmemb (u64 a1))
                                      (sz (u64 a2))
                                      (compar-pc a3)
                                      (tmp (make-bytevector (max 1 (u64 a2)) 0)))
                                  (let iloop ((i 1))
                                    (when (< i nmemb)
                                      (let jloop ((j i))
                                        (when (> j 0)
                                          (let* ((addr-prev (+ base (* (- j 1) sz)))
                                                 (addr-cur  (+ base (* j sz)))
                                                 (cmp (invoke-rv64-callback compar-pc addr-prev addr-cur)))
                                            (when (> cmp 0)
                                              ;; swap elements j-1 and j
                                              (let k1 ((k 0))
                                                (when (< k sz)
                                                  (bytevector-u8-set! tmp k (bytevector-u8-ref mem (+ addr-prev k)))
                                                  (bytevector-u8-set! mem (+ addr-prev k) (bytevector-u8-ref mem (+ addr-cur k)))
                                                  (bytevector-u8-set! mem (+ addr-cur k) (bytevector-u8-ref tmp k))
                                                  (k1 (+ k 1))))
                                              (jloop (- j 1))))))
                                      (iloop (+ i 1))))
                                  (run next-pc)))

                               ((or (string=? sym "bsearch") (string=? sym "stdlib_bsearch"))
                                ;; Binary search on `mem` invoking the RV64G comparator callback at `a4`
                                (let ((key a0)
                                      (base a1)
                                      (nmemb (u64 a2))
                                      (sz (u64 a3))
                                      (compar-pc a4))
                                  (let bloop ((lo 0) (hi nmemb))
                                    (if (>= lo hi)
                                        (begin (set-gp! "a0" 0) (run next-pc))
                                        (let* ((mid (quotient (+ lo hi) 2))
                                               (elem-addr (+ base (* mid sz)))
                                               (cmp (invoke-rv64-callback compar-pc key elem-addr)))
                                          (cond
                                            ((< cmp 0) (bloop lo mid))
                                            ((> cmp 0) (bloop (+ mid 1) hi))
                                            (else
                                             (set-gp! "a0" elem-addr)
                                             (run next-pc))))))))

                               ;; MARV-ABI `stdlib_div` / `stdlib_ldiv` (`a0` = rp, `a1` = num, `a2` = den)
                               ((or (string=? sym "stdlib_div") (string=? sym "stdlib_ldiv")
                                    (string=? sym "_marv_ffi_sret_div"))
                                (let* ((rp  a0)
                                       (num (s32 a1))
                                       (den (s32 a2))
                                       (q   (truncate-quotient num den))
                                       (r   (truncate-remainder num den)))
                                  (sim-store! mem rp q 4)
                                  (sim-store! mem (+ rp 4) r 4)
                                  (run next-pc)))

                               ;; MARV-ABI `stdlib_lldiv` (`a0` = rp, `a1` = num, `a2` = den)
                               ((string=? sym "stdlib_lldiv")
                                (let* ((rp  a0)
                                       (num (s64 a1))
                                       (den (s64 a2))
                                       (q   (truncate-quotient num den))
                                       (r   (truncate-remainder num den)))
                                  (sim-store! mem rp q 8)
                                  (sim-store! mem (+ rp 8) r 8)
                                  (run next-pc)))

                               ;; Native Linux RV64G (LP64D psABI) libc entry points
                               ((string=? sym "div")
                                (let* ((num (s32 a0))
                                       (den (s32 a1))
                                       (q (u32 (truncate-quotient num den)))
                                       (r (u32 (truncate-remainder num den))))
                                  (set-gp! "a0" (s64 (+ q (* r 4294967296))))
                                  (run next-pc)))

                               ((or (string=? sym "ldiv") (string=? sym "lldiv"))
                                (let* ((num (s64 a0))
                                       (den (s64 a1))
                                       (q (truncate-quotient num den))
                                       (r (truncate-remainder num den)))
                                  (set-gp! "a0" q)
                                  (set-gp! "a1" r)
                                  (run next-pc)))

                               ((or (string=? sym "toupper") (string=? sym "ctype_toupper"))
                                (let ((c (s32 a0)))
                                  (set-gp! "a0" (if (and (>= c 97) (<= c 122)) (- c 32) c))
                                  (run next-pc)))

                               ((or (string=? sym "tolower") (string=? sym "ctype_tolower"))
                                (let ((c (s32 a0)))
                                  (set-gp! "a0" (if (and (>= c 65) (<= c 90)) (+ c 32) c))
                                  (run next-pc)))

                               ((or (string=? sym "isdigit") (string=? sym "ctype_isdigit"))
                                (let ((c (s32 a0)))
                                  (set-gp! "a0" (if (and (>= c 48) (<= c 57)) 1 0))
                                  (run next-pc)))

                               ((or (string=? sym "isalpha") (string=? sym "ctype_isalpha"))
                                (let ((c (s32 a0)))
                                  (set-gp! "a0" (if (or (and (>= c 65) (<= c 90))
                                                        (and (>= c 97) (<= c 122)))
                                                    1 0))
                                  (run next-pc)))

                               ((or (string=? sym "errno_get") (string=? sym "_marv_ffi_get_errno"))
                                (set-gp! "a0" (sim-load-s mem #x0818 4))
                                (run next-pc))

                               ((or (string=? sym "errno_set") (string=? sym "_marv_ffi_set_errno"))
                                (sim-store! mem #x0818 (s32 a0) 4)
                                (run next-pc))

                               ((string=? sym "__errno_location")
                                (set-gp! "a0" #x0818)
                                (run next-pc))

                               ((string=? sym "c_invoke_sz_callback")
                                (let ((res (invoke-rv64-callback a0 a1 a2)))
                                  (set-gp! "a0" res)
                                  (run next-pc)))

                               ((string=? sym "_marv_ffi_stream_stdin")
                                (set-gp! "a0" #x7000)
                                (run next-pc))
                               ((string=? sym "_marv_ffi_stream_stdout")
                                (set-gp! "a0" #x7020)
                                (run next-pc))
                               ((string=? sym "_marv_ffi_stream_stderr")
                                (set-gp! "a0" #x7040)
                                (run next-pc))

                               ((or (string=? sym "fputs") (string=? sym "fflush") (string=? sym "puts")
                                    (string=? sym "stdio_fputs") (string=? sym "stdio_fflush") (string=? sym "stdio_puts"))
                                (set-gp! "a0" 0)
                                (run next-pc))

                               ((or (string=? sym "strcmp") (string=? sym "string_strcmp"))
                                (let ((s1 (sim-read-cstring mem a0))
                                      (s2 (sim-read-cstring mem a1)))
                                  (set-gp! "a0" (cond ((string<? s1 s2) -1)
                                                      ((string>? s1 s2)  1)
                                                      (else 0)))
                                  (run next-pc)))

                               ((or (string=? sym "strncmp") (string=? sym "string_strncmp"))
                                (let ((s1 a0) (s2 a1) (n (u64 a2)))
                                  (let nlp ((i 0))
                                    (if (>= i n)
                                        (begin (set-gp! "a0" 0) (run next-pc))
                                        (let ((b1 (bytevector-u8-ref mem (+ s1 i)))
                                              (b2 (bytevector-u8-ref mem (+ s2 i))))
                                          (cond
                                            ((not (= b1 b2))
                                             (set-gp! "a0" (- b1 b2))
                                             (run next-pc))
                                            ((= b1 0)
                                             (set-gp! "a0" 0)
                                             (run next-pc))
                                            (else (nlp (+ i 1)))))))))

                               ;; Simulated `lib/dirent.c` functions on `examples/`
                               ;; Canonical WCPL/MARV `struct dirent` layout:
                               ;;   +0: d_ino  (u64)
                               ;;   +8: d_type (u8)
                               ;;   +9: d_name (char[256] inline)
                               ((string=? sym "dirent_opendir")
                                (let* ((dirp (+ heap-ptr 16))
                                       (ebuf (+ dirp 32)))
                                  (set! heap-ptr (+ dirp 320))
                                  (sim-store! mem dirp 0 8)
                                  (sim-store! mem (+ dirp 8) ebuf 8)
                                  (set-gp! "a0" dirp)
                                  (run next-pc)))

                               ((string=? sym "dirent_readdir")
                                (let* ((dirp a0)
                                       (idx (sim-load-s mem dirp 8))
                                       (ebuf (sim-load-u mem (+ dirp 8) 8))
                                       (entries '#((101 4 "README.md")
                                                   (102 4 "dirent_demo.mvs")
                                                   (103 4 "libc_demo.mvs")
                                                   (104 3 "multimod")
                                                   (105 4 "queens.mvs"))))
                                  (if (or (< idx 0) (>= idx (vector-length entries)))
                                      (begin
                                        (set-gp! "a0" 0)
                                        (run next-pc))
                                      (let* ((item (vector-ref entries idx))
                                             (ino  (car item))
                                             (dt   (cadr item))
                                             (name (caddr item))
                                             (nlen (string-length name)))
                                        (sim-store! mem ebuf ino 8)
                                        (bytevector-u8-set! mem (+ ebuf 8) dt)
                                        (let nlp ((k 0))
                                          (when (< k nlen)
                                            (bytevector-u8-set! mem (+ ebuf 9 k)
                                                                (char->integer (string-ref name k)))
                                            (nlp (+ k 1))))
                                        (bytevector-u8-set! mem (+ ebuf 9 nlen) 0)
                                        (sim-store! mem dirp (+ idx 1) 8)
                                        (set-gp! "a0" ebuf)
                                        (run next-pc)))))

                               ((string=? sym "dirent_rewinddir")
                                (sim-store! mem a0 0 8)
                                (run next-pc))

                               ((string=? sym "dirent_telldir")
                                (set-gp! "a0" (sim-load-s mem a0 8))
                                (run next-pc))

                               ((string=? sym "dirent_seekdir")
                                (sim-store! mem a0 (max 0 (min 5 (s64 a1))) 8)
                                (run next-pc))

                               ((string=? sym "dirent_closedir")
                                (set-gp! "a0" 0)
                                (run next-pc))

                               ((string=? sym "dirent_d_ino")
                                (set-gp! "a0" (sim-load-s mem a0 8))
                                (run next-pc))
                               ((string=? sym "dirent_d_type")
                                (set-gp! "a0" (bytevector-u8-ref mem (+ a0 8)))
                                (run next-pc))
                               ((string=? sym "dirent_d_namlen")
                                (set-gp! "a0" (string-length (sim-read-cstring mem (+ a0 9))))
                                (run next-pc))
                               ((string=? sym "dirent_d_name")
                                (set-gp! "a0" (+ a0 9))
                                (run next-pc))

                               ((string=? sym "dirent_alphasort")
                                ;; `a0` and `a1` are `const struct dirent **` (8-byte pointer slots)
                                (let* ((ea (sim-load-u mem a0 8))
                                       (eb (sim-load-u mem a1 8))
                                       (sa (sim-read-cstring mem (+ ea 9)))
                                       (sb (sim-read-cstring mem (+ eb 9))))
                                  (set-gp! "a0" (cond ((string<? sa sb) -1)
                                                      ((string>? sa sb)  1)
                                                      (else 0)))
                                  (run next-pc)))

                               ((string=? sym "dirent_scandir")
                                ;; a0=dir, a1=namelist_out, a2=filter_pc, a3=compar_pc
                                ;; Note: `filter` takes `const struct dirent *` (`ent`),
                                ;; while `compar` (like `alphasort`) takes `const struct dirent **` (`pa`, `pb`)!
                                (let ((namelist-out a1)
                                      (filter-pc a2)
                                      (compar-pc a3)
                                      (entries '((105 4 "queens.mvs")
                                                 (101 4 "README.md")
                                                 (104 3 "multimod")
                                                 (103 4 "libc_demo.mvs")
                                                 (102 4 "dirent_demo.mvs")))
                                      (kept '()))
                                  (for-each
                                    (lambda (item)
                                      (let* ((ino  (car item))
                                             (dt   (cadr item))
                                             (name (caddr item))
                                             (nlen (string-length name))
                                             (ent  (+ heap-ptr 16)))
                                        (set! heap-ptr (+ ent 272))
                                        (sim-store! mem ent ino 8)
                                        (bytevector-u8-set! mem (+ ent 8) dt)
                                        (let nlp ((k 0))
                                          (when (< k nlen)
                                            (bytevector-u8-set! mem (+ ent 9 k)
                                                                (char->integer (string-ref name k)))
                                            (nlp (+ k 1))))
                                        (bytevector-u8-set! mem (+ ent 9 nlen) 0)
                                        (when (or (= filter-pc 0)
                                                  (not (= (invoke-rv64-callback filter-pc ent 0) 0)))
                                          (set! kept (append kept (list ent))))))
                                    entries)
                                  (let* ((cnt (length kept))
                                         (slots-addr (+ heap-ptr 16)))
                                    (set! heap-ptr (+ slots-addr (* (+ cnt 1) 8)))
                                    (let slp ((ks kept) (i 0))
                                      (when (pair? ks)
                                        (sim-store! mem (+ slots-addr (* i 8)) (car ks) 8)
                                        (slp (cdr ks) (+ i 1))))
                                    ;; Insertion sort on 8-byte slots: pass `pa` and `pb` (`struct dirent **`) to `compar`!
                                    (when (and (not (= compar-pc 0)) (> cnt 1))
                                      (let ilp ((i 1))
                                        (when (< i cnt)
                                          (let jlp ((j i))
                                            (when (> j 0)
                                              (let* ((pa (+ slots-addr (* (- j 1) 8)))
                                                     (pb (+ slots-addr (* j 8)))
                                                     (ea (sim-load-u mem pa 8))
                                                     (eb (sim-load-u mem pb 8)))
                                                (when (> (invoke-rv64-callback compar-pc pa pb) 0)
                                                  (sim-store! mem pa eb 8)
                                                  (sim-store! mem pb ea 8)
                                                  (jlp (- j 1))))))
                                          (ilp (+ i 1)))))
                                    (sim-store! mem namelist-out slots-addr 8)
                                    (set-gp! "a0" cnt)
                                    (run next-pc))))

                               ((string=? sym "dirent_freelist")
                                (run next-pc))

                               ((or (string=? sym "sqrt") (string=? sym "math_sqrt"))
                                (set-fp! "fa0" (flsqrt fa0))
                                (run next-pc))

                               ((or (string=? sym "cos") (string=? sym "math_cos"))
                                (set-fp! "fa0" (flcos fa0))
                                (run next-pc))

                               ((or (string=? sym "sin") (string=? sym "math_sin"))
                                (set-fp! "fa0" (flsin fa0))
                                (run next-pc))

                               ;; Nested module `math.vec` (`lib/math/vec.c`)
                               ((string=? sym "math_vec_dot")
                                (let* ((ax (ieee64-bits->flonum (sim-load-u mem a0 8)))
                                       (ay (ieee64-bits->flonum (sim-load-u mem (+ a0 8) 8)))
                                       (az (ieee64-bits->flonum (sim-load-u mem (+ a0 16) 8)))
                                       (bx (ieee64-bits->flonum (sim-load-u mem a1 8)))
                                       (by (ieee64-bits->flonum (sim-load-u mem (+ a1 8) 8)))
                                       (bz (ieee64-bits->flonum (sim-load-u mem (+ a1 16) 8))))
                                  (set-fp! "fa0" (+ (* ax bx) (* ay by) (* az bz)))
                                  (run next-pc)))

                               ((string=? sym "math_vec_cross")
                                ;; `a0` = rp, `a1` = a, `a2` = b
                                (let* ((rp a0)
                                       (ax (ieee64-bits->flonum (sim-load-u mem a1 8)))
                                       (ay (ieee64-bits->flonum (sim-load-u mem (+ a1 8) 8)))
                                       (az (ieee64-bits->flonum (sim-load-u mem (+ a1 16) 8)))
                                       (bx (ieee64-bits->flonum (sim-load-u mem a2 8)))
                                       (by (ieee64-bits->flonum (sim-load-u mem (+ a2 8) 8)))
                                       (bz (ieee64-bits->flonum (sim-load-u mem (+ a2 16) 8)))
                                       (cx (- (* ay bz) (* az by)))
                                       (cy (- (* az bx) (* ax bz)))
                                       (cz (- (* ax by) (* ay bx))))
                                  (sim-store! mem rp        (flonum->ieee64-bits cx) 8)
                                  (sim-store! mem (+ rp 8)  (flonum->ieee64-bits cy) 8)
                                  (sim-store! mem (+ rp 16) (flonum->ieee64-bits cz) 8)
                                  (run next-pc)))

                               ((string=? sym "math_vec_norm")
                                (let* ((vx (ieee64-bits->flonum (sim-load-u mem a0 8)))
                                       (vy (ieee64-bits->flonum (sim-load-u mem (+ a0 8) 8)))
                                       (vz (ieee64-bits->flonum (sim-load-u mem (+ a0 16) 8))))
                                  (set-fp! "fa0" (flsqrt (+ (* vx vx) (* vy vy) (* vz vz))))
                                  (run next-pc)))

                               ;; `sys.stat` (`lib/sys/stat.c`) on "."
                               ((or (string=? sym "stat_stat") (string=? sym "sys_stat_stat")
                                    (string=? sym "stat_lstat") (string=? sym "sys_stat_lstat"))
                                (let ((buf a1))
                                  ;; Populate 80-byte MARV/WCPL `struct stat` for directory "."
                                  (sim-store! mem (+ buf 0)  1 8)        ;; st_dev
                                  (sim-store! mem (+ buf 8)  100 8)      ;; st_ino
                                  (sim-store! mem (+ buf 16) 2 8)        ;; st_nlink
                                  (sim-store! mem (+ buf 24) #o040755 4) ;; st_mode (S_IFDIR | 0755)
                                  (sim-store! mem (+ buf 32) 4096 8)     ;; st_size
                                  (set-gp! "a0" 0)
                                  (run next-pc)))

                               ((or (string=? sym "strtoll") (string=? sym "stdlib_strtoll"))
                                (let* ((s (sim-read-cstring mem a0))
                                       (endp a1)
                                       (len (string-length s)))
                                  (let skip-ws ((i 0))
                                    (if (and (< i len) (char-whitespace? (string-ref s i)))
                                        (skip-ws (+ i 1))
                                        (let* ((sign (cond ((and (< i len) (char=? (string-ref s i) #\-)) -1)
                                                           ((and (< i len) (char=? (string-ref s i) #\+)) 1)
                                                           (else 1)))
                                               (start (if (and (< i len) (memv (string-ref s i) '(#\- #\+)))
                                                          (+ i 1)
                                                          i)))
                                          (let dloop ((k start) (acc 0))
                                            (if (and (< k len) (char-numeric? (string-ref s k)))
                                                (dloop (+ k 1)
                                                       (+ (* acc 10)
                                                          (- (char->integer (string-ref s k)) 48)))
                                                (begin
                                                  (when (> endp 0)
                                                    (sim-store! mem endp (+ a0 k) 8))
                                                  (set-gp! "a0" (* sign acc))
                                                  (run next-pc)))))))))

                               ((or (string=? sym "strtod") (string=? sym "stdlib_strtod"))
                                (let* ((s (sim-read-cstring mem a0))
                                       (endp a1)
                                       (len (string-length s)))
                                  (let skip-ws ((i 0))
                                    (if (and (< i len) (char-whitespace? (string-ref s i)))
                                        (skip-ws (+ i 1))
                                        (let cloop ((k i))
                                          (if (and (< k len)
                                                   (let ((c (string-ref s k)))
                                                     (or (char-numeric? c)
                                                         (memv c '(#\. #\- #\+ #\e #\E)))))
                                              (cloop (+ k 1))
                                              (let ((num (string->number (substring s i k))))
                                                (when (> endp 0)
                                                  (sim-store! mem endp (+ a0 k) 8))
                                                (set-fp! "fa0" (inexact (or num 0.0)))
                                                (run next-pc))))))))

                               ;; MARV-ABI `stdio_snprintf(buf, size, fmt, ap)` where `ap` points to 16-byte `va_arg_t` slots
                               ((string=? sym "stdio_snprintf")
                                (let ((buf a0)
                                      (maxsize (u64 a1))
                                      (fmt a2)
                                      (ap a3)
                                      (va-idx 0))
                                  (let* ((formatted
                                           (sim-format-snprintf
                                             mem fmt
                                             (lambda ()
                                               (let ((v (sim-load-u mem (+ ap (* va-idx 16)) 8)))
                                                 (set! va-idx (+ va-idx 1))
                                                 v))))
                                         (flen (string-length formatted))
                                         (write-n (if (> maxsize 0) (min flen (- maxsize 1)) 0)))
                                    (when (> maxsize 0)
                                      (let wlp ((i 0))
                                        (when (< i write-n)
                                          (bytevector-u8-set! mem (+ buf i)
                                                              (char->integer (string-ref formatted i)))
                                          (wlp (+ i 1))))
                                      (bytevector-u8-set! mem (+ buf write-n) 0))
                                    (set-gp! "a0" flen)
                                    (run next-pc))))

                               ;; MARV-ABI `stdio_sprintf(buf, fmt, ap)` where `ap` points to 16-byte `va_arg_t` slots
                               ((string=? sym "stdio_sprintf")
                                (let ((buf a0)
                                      (fmt a1)
                                      (ap  a2)
                                      (va-idx 0))
                                  (let* ((formatted
                                           (sim-format-snprintf
                                             mem fmt
                                             (lambda ()
                                               (let ((v (sim-load-u mem (+ ap (* va-idx 16)) 8)))
                                                 (set! va-idx (+ va-idx 1))
                                                 v))))
                                         (flen (string-length formatted)))
                                    (let wlp ((i 0))
                                      (when (< i flen)
                                        (bytevector-u8-set! mem (+ buf i)
                                                            (char->integer (string-ref formatted i)))
                                        (wlp (+ i 1))))
                                    (bytevector-u8-set! mem (+ buf flen) 0)
                                    (set-gp! "a0" flen)
                                    (run next-pc))))

                               ;; MARV-ABI `stdio_printf(fmt, ap)` and `stdio_fprintf(fp, fmt, ap)`
                               ((or (string=? sym "stdio_printf") (string=? sym "stdio_fprintf"))
                                (let* ((is-fp? (string=? sym "stdio_fprintf"))
                                       (fmt (if is-fp? a1 a0))
                                       (ap  (if is-fp? a2 a1))
                                       (va-idx 0)
                                       (formatted
                                         (sim-format-snprintf
                                           mem fmt
                                           (lambda ()
                                             (let ((v (sim-load-u mem (+ ap (* va-idx 16)) 8)))
                                               (set! va-idx (+ va-idx 1))
                                               v)))))
                                  (set-gp! "a0" (string-length formatted))
                                  (run next-pc)))

                               ((string=? sym "snprintf")
                                ;; Fixed args: a0=buf, a1=size, a2=fmt; varargs start at a3..a7 then stack
                                (let ((buf a0)
                                      (maxsize (u64 a1))
                                      (fmt a2)
                                      (va-idx 3))
                                  (let* ((formatted
                                           (sim-format-snprintf
                                             mem fmt
                                             (lambda ()
                                               (let ((v (if (< va-idx 8)
                                                            (vector-ref gp (+ 10 va-idx))
                                                            (sim-load-u mem (+ (get-gp "sp") (* (- va-idx 8) 8)) 8))))
                                                 (set! va-idx (+ va-idx 1))
                                                 v))))
                                         (flen (string-length formatted))
                                         (write-n (if (> maxsize 0) (min flen (- maxsize 1)) 0)))
                                    (when (> maxsize 0)
                                      (let wlp ((i 0))
                                        (when (< i write-n)
                                          (bytevector-u8-set! mem (+ buf i)
                                                              (char->integer (string-ref formatted i)))
                                          (wlp (+ i 1))))
                                      (bytevector-u8-set! mem (+ buf write-n) 0))
                                    (set-gp! "a0" flen)
                                    (run next-pc))))

                               (else
                                (error "unknown external call in RV64G simulator" sym)))))))
                    ((string=? op "jalr")
                     (let* ((rd (car ops))
                            (mp (rv-parse-memop (cadr ops)))
                            (target (+ (get-gp (cdr mp)) (car mp))))
                       (set-gp! rd next-pc)
                       (run target)))
                    ((string=? op "tail")
                     (run (resolve-sym (car ops))))
                    ((string=? op "jr")
                     (run (get-gp (car ops))))
                    ((string=? op "ret")
                     (run (get-gp "ra")))

                    (else
                     (error "unhandled RV64G instruction in simulator" ins))))))))))
